<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Full & Final Settlement Statement</title>
    <style>
        @page {
            margin: 10mm 12mm;
            size: A4 portrait;
        }

        body { 
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; 
            color: #1e293b; 
            line-height: 1.45; 
            font-size: 11.5px; 
            margin: 0;
            padding: 0;
        }

        /* Header Styling */
        .header-table {
            width: 100%;
            border-bottom: 2px solid #f27022;
            padding-bottom: 10px;
            margin-bottom: 16px;
        }

        .logo { 
            height: 55px; 
            width: auto; 
            object-fit: contain;
        }

        .statement-label {
            text-align: right;
            vertical-align: middle;
        }

        .statement-title {
            font-size: 18px;
            font-weight: 700;
            color: #f27022;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 0 0 2px 0;
        }

        .issue-date {
            font-size: 10.5px;
            color: #64748b;
        }

        /* Employee Info Grid */
        .info-section {
            width: 100%;
            margin-bottom: 16px;
            border-collapse: collapse;
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 4px;
        }

        .info-cell {
            width: 50%;
            padding: 10px 14px;
            vertical-align: top;
        }

        .label { 
            font-weight: 600; 
            color: #475569; 
            width: 120px; 
            display: inline-block; 
        }

        /* Settlement Table */
        .settlement-table {
            width: 100%;
            border-collapse: collapse;
            margin: 16px 0;
            border: 1px solid #cbd5e1;
        }

        .settlement-table th {
            background-color: #f27022;
            color: white;
            text-align: left;
            padding: 8px 12px;
            text-transform: uppercase;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .settlement-table td {
            padding: 8px 12px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 11px;
        }

        .amount-col { 
            text-align: right; 
            font-weight: 600; 
            color: #0f172a;
        }

        .net-payable-row {
            background-color: #fff5f0;
            font-size: 13px;
            font-weight: 700;
        }

        .net-payable-row td {
            color: #f27022;
            border-top: 2px solid #f27022;
            border-bottom: 2px solid #f27022;
            padding: 10px 12px;
        }

        .note-text {
            font-size: 10.5px;
            margin-top: 10px;
            color: #64748b;
            font-style: italic;
        }

        /* Signatures */
        .signature-section {
            margin-top: 45px;
            width: 100%;
        }

        .sig-box {
            width: 45%;
            padding-top: 8px;
            border-top: 1px solid #94a3b8;
            text-align: center;
            font-size: 11px;
            color: #1e293b;
        }

        .footer {
            margin-top: 50px;
            width: 100%;
            text-align: center;
            font-size: 11px;
            color: #64748b;
            border-top: 1px solid #e2e8f0;
            padding-top: 10px;
        }
    </style>
</head>
<body>

    <table class="header-table">
        <tr>
            <td>
                <img src="<%= logo %>" class="logo" alt="Viral Ads Media">
            </td>
            <td class="statement-label">
                <p class="statement-title">Full & Final Statement</p>
                <span class="issue-date">Date of Issue: <%= currentDate %></span>
            </td>
        </tr>
    </table>

    <table class="info-section">
        <tr>
            <td class="info-cell">
                <span class="label">Employee Name:</span> <strong><%= employeeName %></strong><br> 
                <span class="label">Employee ID:</span> <%= typeof employeeId !== 'undefined' ? employeeId : 'N/A' %><br>
                <span class="label">Designation:</span> <%= typeof designation !== 'undefined' ? designation : 'Employee' %><br>
                <span class="label">Account No:</span> <%= typeof bankAccount !== 'undefined' ? bankAccount : 'N/A' %><br>
                <span class="label">Address:</span> <%= typeof address !== 'undefined' ? address : 'N/A' %>
            </td>
            <td class="info-cell">
                <span class="label">Date of Joining:</span> <%= dateOfJoining %><br> 
                <span class="label">Last Working Day:</span> <%= lastWorkingDay %><br> 
                <span class="label">Contact:</span> <%= phone %> <br>
                <span class="label">IFSC:</span> <%= typeof ifsc !== 'undefined' ? ifsc : 'N/A' %><br>
                <span class="label">Email:</span> <%= email %> <br>
            </td>
        </tr>
    </table>

    <table class="settlement-table">
        <thead>
            <tr>
                <th>Particulars</th>
                <th style="text-align: right;">Amount (INR)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Pending Salary / Basic Pay</td>
                <td class="amount-col"><%= pendingSalary %></td>
            </tr>
            <tr>
                <td>Leave Encashment</td>
                <td class="amount-col"><%= leaveEncashment %></td>
            </tr>
            <tr>
                <td>Bonus / Performance Incentive</td>
                <td class="amount-col"><%= incentive %></td>
            </tr>
            <tr>
                <td>Other Allowances</td>
                <td class="amount-col">0.00</td>
            </tr>
            <tr>
                <td style="color: #dc2626;">Deductions (TDS/LWP/Notice Recovery)</td>
                <td class="amount-col" style="color: #dc2626;">- <%= deductions %></td>
            </tr>
            <tr class="net-payable-row">
                <td>NET PAYABLE AMOUNT</td>
                <td class="amount-col">₹ <%= totalPayable %></td>
            </tr>
        </tbody>
    </table>

    <p class="note-text">
        * This is a computer-generated statement. The net payable amount will be credited to your bank account registered with Viral Ads Media.
    </p>

    <table class="signature-section">
        <tr>
            <td class="sig-box">
                <strong>Prepared By</strong><br>
                HR & Accounts Department<br>
                Viral Ads Media
            </td>
            <td style="width: 55%;"></td>
        </tr>
    </table>

    <div class="footer">
        <strong>Viral Ads Media</strong> | Digital Creative Agency <br>
        <%= companyAddress %>
    </div>

</body>
</html>