<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Full & Final Settlement Statement</title>
    <style>
        @page {
            margin: 0.5in;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            color: #1a1a2e; 
            line-height: 1.6; 
            font-size: 13px; 
            background: #f8f9fa;
            padding: 40px 0;
            margin: 0;
        }

        .document-wrapper {
            max-width: 900px;
            margin: 0 auto;
            background: #ffffff;
            padding: 45px 50px 35px;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.08), 0 8px 20px rgba(0,0,0,0.02);
        }

        /* Header */
        .header-table {
            width: 100%;
            border-bottom: 4px solid #f27022;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }
        .header-table td {
            vertical-align: middle;
        }
        .logo {
            width: 160px;
            height: auto;
        }
        .statement-label {
            text-align: right;
        }
        .statement-title {
            font-size: 22px;
            font-weight: 700;
            color: #f27022;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin: 0;
        }
        .issue-date {
            font-size: 12px;
            color: #888;
            font-weight: 400;
            display: block;
            margin-top: 4px;
        }

        /* Info Section */
        .info-section {
            width: 100%;
            margin-bottom: 30px;
            border-collapse: collapse;
            background: #fafbfc;
            border-radius: 8px;
            overflow: hidden;
        }
        .info-section td {
            padding: 14px 20px;
            vertical-align: top;
            border-right: 1px solid #eef0f2;
        }
        .info-section td:last-child {
            border-right: none;
        }
        .info-cell {
            width: 50%;
        }
        .info-cell .label {
            font-weight: 600;
            color: #555;
            display: inline-block;
            min-width: 130px;
            font-size: 12px;
            letter-spacing: 0.3px;
        }
        .info-cell .value {
            font-weight: 600;
            color: #1a1a2e;
        }
        .info-cell br {
            line-height: 2.2;
        }

        /* Settlement Table */
        .settlement-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0 25px;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        }
        .settlement-table th {
            background: #f27022;
            color: #fff;
            text-align: left;
            padding: 14px 18px;
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 0.8px;
            font-weight: 600;
        }
        .settlement-table td {
            padding: 14px 18px;
            border-bottom: 1px solid #edf0f5;
            background: #fff;
        }
        .settlement-table tr:last-child td {
            border-bottom: none;
        }
        .settlement-table .amount-col {
            text-align: right;
            font-family: 'Courier New', Courier, monospace;
            font-weight: 600;
            font-size: 14px;
        }
        
        .net-payable-row td {
            background: #fff5f0;
            font-size: 17px;
            font-weight: 700;
            color: #f27022;
            border-top: 3px solid #f27022;
            border-bottom: 3px solid #f27022;
            padding: 16px 18px;
        }
        .net-payable-row .amount-col {
            font-size: 19px;
        }

        /* Note */
        .disclaimer-note {
            font-size: 11.5px;
            margin-top: 15px;
            padding: 12px 18px;
            background: #f8f9fb;
            border-left: 4px solid #f27022;
            border-radius: 4px;
            color: #555;
            font-style: italic;
        }

        /* Signature */
        .signature-section {
            margin-top: 55px;
            width: 100%;
            border-collapse: collapse;
        }
        .signature-section td {
            padding: 0 10px;
            vertical-align: bottom;
        }
        .sig-box {
            padding-top: 35px;
            border-top: 2px solid #d0d5dd;
            text-align: center;
            font-size: 13px;
            color: #333;
        }
        .sig-box strong {
            display: block;
            font-size: 14px;
            color: #1a1a2e;
            margin-bottom: 4px;
        }
        .sig-box .sub-text {
            font-size: 11px;
            color: #777;
            font-weight: 400;
        }

        /* Footer */
        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 12px;
            color: #999;
            border-top: 1px solid #e8ebf0;
            padding-top: 18px;
            letter-spacing: 0.3px;
        }
        .footer strong {
            color: #1a1a2e;
            font-weight: 600;
        }

        /* Responsive */
        @media (max-width: 600px) {
            .document-wrapper {
                padding: 25px 20px;
                margin: 10px;
            }
            .header-table td {
                display: block;
                text-align: center !important;
            }
            .statement-label {
                text-align: center !important;
                margin-top: 10px;
            }
            .info-section td {
                display: block;
                width: 100% !important;
                border-right: none;
                border-bottom: 1px solid #eee;
            }
            .info-section td:last-child {
                border-bottom: none;
            }
            .info-cell .label {
                min-width: 100px;
            }
            .signature-section td {
                display: block;
                width: 100% !important;
                margin-bottom: 20px;
            }
            .sig-box {
                width: 100% !important;
            }
            .settlement-table th,
            .settlement-table td {
                padding: 10px 12px;
                font-size: 12px;
            }
        }
    </style>
</head>
<body>

<div class="document-wrapper">

    <table class="header-table">
        <tr>
            <td>
                <img src="<%= logo %>" class="logo" alt="Viral Ads Media Logo">
            </td>
            <td class="statement-label">
                <div class="statement-title">Full & Final Statement</div>
                <span class="issue-date">Date of Issue: <%= currentDate %></span>
            </td>
        </tr>
    </table>

    <table class="info-section">
        <tr>
            <td class="info-cell">
                <span class="label">Employee Name:</span> <span class="value"><%= employeeName %></span><br>
                <span class="label">Employee ID:</span> <span class="value"><%= typeof employeeId !== 'undefined' ? employeeId : 'N/A' %></span><br>
                <span class="label">Designation:</span> <span class="value"><%= typeof designation !== 'undefined' ? designation : 'Employee' %></span><br>
                <span class="label">Account No:</span> <span class="value"><%= typeof bankAccount !== 'undefined' ? bankAccount : 'N/A' %></span><br>
                <span class="label">Address:</span> <span class="value"><%= typeof address !== 'undefined' ? address : 'N/A' %></span>
            </td>
            <td class="info-cell">
                <span class="label">Date of Joining:</span> <span class="value"><%= dateOfJoining %></span><br>
                <span class="label">Last Working Day:</span> <span class="value"><%= lastWorkingDay %></span><br>
                <span class="label">Contact:</span> <span class="value"><%= phone %></span><br>
                <span class="label">IFSC:</span> <span class="value"><%= typeof ifsc !== 'undefined' ? ifsc : 'N/A' %></span><br>
                <span class="label">Email:</span> <span class="value"><%= email %></span>
            </td>
        </tr>
    </table>

    <table class="settlement-table">
        <thead>
            <tr>
                <th>Particulars</th>
                <th style="text-align: right;">Amount (INR)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Pending Salary / Basic Pay</td>
                <td class="amount-col"><%= pendingSalary %></td>
            </tr>
            <tr>
                <td>Leave Encashment</td>
                <td class="amount-col"><%= leaveEncashment %></td>
            </tr>
            <tr>
                <td>Bonus / Performance Incentive</td>
                <td class="amount-col"><%= incentive %></td>
            </tr>
            <tr>
                <td>Other Allowances</td>
                <td class="amount-col">0.00</td>
            </tr>
            <tr>
                <td style="color: #c62828;">Deductions (TDS/LWP/Notice Recovery)</td>
                <td class="amount-col" style="color: #c62828;">- <%= deductions %></td>
            </tr>
            <tr class="net-payable-row">
                <td>NET PAYABLE AMOUNT</td>
                <td class="amount-col">₹ <%= totalPayable %></td>
            </tr>
        </tbody>
    </table>

    <div class="disclaimer-note">
        * This is a computer-generated statement. The net payable amount will be credited to your bank account registered with Viral Ads Media.
    </div>

    <table class="signature-section">
        <tr>
            <td class="sig-box">
                <strong>Prepared By</strong>
                <span class="sub-text">HR &amp; Accounts Department</span><br>
                <span class="sub-text">Viral Ads Media</span>
            </td>
            <td style="width: 15%;"></td>
            <td class="sig-box">
                <strong>Employee Acknowledgment</strong>
                <span class="sub-text">Name: <%= employeeName %></span>
            </td>
        </tr>
    </table>

    <div class="footer">
        <strong>Viral Ads Media</strong> &nbsp;|&nbsp; Digital Creative Agency<br>
        <%= companyAddress %>
    </div>

</div>

</body>
</html>